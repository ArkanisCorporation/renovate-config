{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "labels": [
        "automated"
    ],
    // Batch routine CI work on Saturday mornings in the team's local timezone (DST-aware).
    "timezone": "Europe/Prague",
    "schedule": ["* 0-7 * * 6"],
    "updateNotScheduled": false,
    // GitHub-native automerge cannot honour Renovate's automergeSchedule.
    "platformAutomerge": false,
    "automergeType": "pr",
    "ignoreTests": false,
    // Renovate's own age/confidence checks must not substitute for repository CI.
    "internalChecksAsSuccess": false,
    "automergeSchedule": ["* 0-7 * * 6"],
    // Limit both new branches and automatic rebases, not just new PRs; limits are per repo.
    "commitHourlyLimit": 2,
    "prHourlyLimit": 2,
    "prConcurrentLimit": 5,
    "rebaseWhen": "auto",
    // Prefer releases that have had time to settle. Registries without timestamps still update.
    "minimumReleaseAge": "3 days",
    "minimumReleaseAgeBehaviour": "timestamp-optional",
    "internalChecksFilter": "strict",
    "vulnerabilityAlerts": {
        "enabled": true,
        "schedule": ["at any time"],
        "updateNotScheduled": true,
        "minimumReleaseAge": "0 days",
        "dependencyDashboardApproval": false,
        "automerge": false
    },
    "lockFileMaintenance": {
        "enabled": true,
        // Its own schedule overrides the normal window: first Saturday of each month only.
        "schedule": ["* 0-7 1-7 * 6"]
    },
    "packageRules": [
        // Renovate-managed automerge checks CI itself (platformAutomerge: false,
        // ignoreTests: false), including on private repos without branch protection.
        // GitHub-native automerge instead needs enforced required checks; do not enable
        // platformAutomerge casually. Missing/unreported workflows cannot be enforced
        // by this preset. Use manual to require human merging for every update:
        //
        //   "extends": ["github>ArkanisCorporation/renovate-config:manual"]
        //
        // See README.md for CI gating, scheduling and remaining boundaries.

        // Automerge all minor/patch/pin/digest updates by default.
        // Individual manager rules below OVERRIDE this for groups that warrant review.
        {
            "matchUpdateTypes": [
                "minor",
                "patch",
                "pin",
                "digest"
            ],
            "automerge": true
        },

        // ⚠️ BEHAVIOR CHANGE vs previous per-repo configs:
        // GitHub Actions updates are now GROUPED into a single "GitHub Actions" PR and
        // require MANUAL REVIEW (automerge: false). Previously, each action version
        // automerged individually on minor/patch.
        //
        // Rationale: CI infrastructure changes are low-volume, easy to review in batch,
        // and worth a human glance before they affect every workflow run.
        //
        // To restore individual automerge, add this to your repo's renovate.jsonc:
        //   { "matchManagers": ["github-actions"], "automerge": true }
        //
        // "pinDigest" is included so the one-time tag -> SHA conversion from the pinning
        // rules below lands in this same grouped, reviewed PR instead of one PR per action.
        {
            "matchManagers": [
                "github-actions"
            ],
            "groupName": "GitHub Actions",
            "matchUpdateTypes": [
                "minor",
                "patch",
                "digest",
                "pinDigest"
            ],
            "automerge": false
        },

        // Pin third-party GitHub Actions and reusable workflows to full commit SHAs
        // (`uses: owner/action@<40-char-sha> # v4.3.1`), so a moved or compromised upstream
        // tag cannot change what runs without a reviewed Renovate PR (ARK-662, ARK-358).
        //
        // Equivalent to Renovate's `helpers:pinGitHubActionDigestsToSemver`, inlined so it
        // can exclude ArkanisCorporation/**: our own ci repo is consumed via the floating
        // `@v1` tag on purpose (moving that tag is how CI changes roll out org-wide), and the
        // helper's semver extractVersion would otherwise rewrite those refs too.
        {
            "description": "Pin third-party GitHub Action digests",
            "matchDepTypes": [
                "action",
                "workflow"
            ],
            "matchPackageNames": [
                "!ArkanisCorporation/**"
            ],
            "pinDigests": true
        },
        {
            "description": "Resolve pinned third-party GitHub Actions to exact SemVer version comments",
            "matchDepTypes": [
                "action",
                "workflow"
            ],
            "matchPackageNames": [
                "!ArkanisCorporation/**"
            ],
            "extractVersion": "^(?<version>v?\\d+\\.\\d+\\.\\d+)$",
            "versioning": "regex:^v?(?<major>\\d+)(\\.(?<minor>\\d+)\\.(?<patch>\\d+))?$"
        },

        // ⚠️ BEHAVIOR CHANGE vs previous per-repo configs:
        // NuGet (.NET) updates are now GROUPED into a single ".NET dependencies and tools"
        // PR and require MANUAL REVIEW (automerge: false). Previously, each package
        // automerged individually on minor/patch.
        //
        // Rationale: NuGet dependency updates benefit from a single grouped PR so you can
        // assess the whole picture (did anything shift together that looks suspicious?)
        // before merging. The volume is manageable as a batch.
        //
        // To restore automerge (grouped PR still exists, merges automatically once checks
        // pass), add this to your repo's renovate.jsonc packageRules:
        //   { "matchManagers": ["nuget"], "automerge": true }
        {
            "matchManagers": [
                "nuget"
            ],
            "groupName": ".NET dependencies and tools",
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "automerge": false
        },

        {
          "description": "Require approval for NuGet major updates",
          "matchManagers": [
              "nuget"
          ],
          "matchUpdateTypes": [
              "major"
          ],
          "dependencyDashboardApproval": true
        },

        {
          "description": "Run workload restore for .NET workload-based projects",
          "matchManagers": [
              "nuget"
          ],
          "postUpdateOptions": [
              "dotnetWorkloadRestore"
          ]
        },

        // semantic-release toolchain — grouped, manual review.
        // These control release automation; a bad update breaks every repo's publish pipeline.
        {
            "matchDatasources": [
                "npm"
            ],
            "matchDepNames": [
                "semantic-release",
                "@semantic-release/changelog",
                "@semantic-release/exec"
            ],
            "groupName": "semantic-release",
            "automerge": false
        },

        // Kubernetes deployment tools (kubectl, helm) — grouped, manual review.
        // Versions are often pinned for cluster compat; review before bumping.
        {
            "matchDatasources": [
                "github-releases"
            ],
            "matchDepNames": [
                "kubernetes/kubernetes",
                "helm/helm"
            ],
            "groupName": "Kubernetes deployment tools",
            "automerge": false
        },

        // Never automerge major updates regardless of any other rule.
        {
            "matchUpdateTypes": [
                "major"
            ],
            "automerge": false
        }
    ],
    "customManagers": [
        // Track semantic-release version pinned as `semantic_version: x.y.z` in workflow files.
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/^\\.github/workflows/.*\\.ya?ml$/"
            ],
            "matchStrings": [
                "semantic_version:\\s*(?<currentValue>\\S+)"
            ],
            "depNameTemplate": "semantic-release",
            "datasourceTemplate": "npm"
        },
        // Track @semantic-release/plugin@x.y.z inline pins in workflow files.
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/^\\.github/workflows/.*\\.ya?ml$/"
            ],
            "matchStrings": [
                "(?<depName>@semantic-release/[a-z-]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
            ],
            "datasourceTemplate": "npm"
        },
        // Track kubectl version pinned as `kubectl_version: vX.Y.Z` in workflow files.
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/^\\.github/workflows/.*\\.ya?ml$/"
            ],
            "matchStrings": [
                "kubectl_version:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)",
                "kubectl_version:[\\s\\S]*?default:\\s*\"?(?<currentValue>v\\d+\\.\\d+\\.\\d+)\"?"
            ],
            "depNameTemplate": "kubernetes/kubernetes",
            "datasourceTemplate": "github-releases"
        },
        // Track helm version pinned as `helm_version: vX.Y.Z` in workflow files.
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/^\\.github/workflows/.*\\.ya?ml$/"
            ],
            "matchStrings": [
                "helm_version:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)",
                "helm_version:[\\s\\S]*?default:\\s*\"?(?<currentValue>v\\d+\\.\\d+\\.\\d+)\"?"
            ],
            "depNameTemplate": "helm/helm",
            "datasourceTemplate": "github-releases"
        },
        // Track Docker image tags in static Aspire AppHost container declarations.
        //
        // Supported forms:
        //   .AddContainer("resource", "registry/image", "tag")
        //   .WithImage("registry/image", "tag")
        //   .WithImage("registry/image").WithImageTag("tag")
        //
        // This matcher is intentionally text-based, so matching examples in comments are
        // updated together with live declarations. The tagless WithImage form can include
        // further fluent calls, but only before its WithImageTag and never across a semicolon.
        // Comments between the two methods are not supported.
        {
            "customType": "regex",
            "description": "Update static Aspire container image tags",
            "managerFilePatterns": [
                "/(^|/)AppHost\\.cs$/"
            ],
            "matchStrings": [
                "\\.AddContainer\\(\\s*\"[^\"]+\"\\s*,\\s*\"(?<depName>[^\"]+)\"\\s*,\\s*\"(?<currentValue>[^\"]+)\"\\s*\\)",
                "\\.WithImage\\(\\s*\"(?<depName>[^\"]+)\"\\s*,\\s*\"(?<currentValue>[^\"]+)\"\\s*\\)",
                "\\.WithImage\\(\\s*\"(?<depName>[^\"]+)\"\\s*\\)(?:\\s*\\.[A-Za-z_][A-Za-z0-9_]*\\s*\\([^;]*?\\))*?\\s*\\.WithImageTag\\(\\s*\"(?<currentValue>[^\"]+)\"\\s*\\)"
            ],
            "datasourceTemplate": "docker",
            "versioningTemplate": "docker"
        }
    ]
}

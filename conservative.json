{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    // Compatibility preset for repositories that disabled automerge solely because
    // GitHub-native automerge could not enforce checks on their private/free repository.
    // The default now uses Renovate-managed PR automerge, waits for CI, and enforces
    // the Saturday merge window, so this preset inherits that behavior unchanged.
    // BEHAVIOR CHANGE: eligible updates can now automerge after CI passes.
    // Existing manager/package manual-review exceptions still apply.
    // For deliberately human-only merging use renovate-config:manual instead.
    //
    // USAGE — replace the extends line in your renovate.jsonc:
    //   "extends": ["github>ArkanisCorporation/renovate-config:conservative"]
    //
    "extends": [
        "github>ArkanisCorporation/renovate-config"
    ]
}
